{
  "name": "pcp-engine",
  "version": "5.3.4",
  "type": "module",
  "description": "PCP: the prompt quality engine. Deterministic scoring, compilation, cost estimation & governance for AI prompts. Zero LLM calls.",
  "main": "dist/src/api.js",
  "types": "dist/src/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/api.d.ts",
      "import": "./dist/src/api.js"
    },
    "./server": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./validate": {
      "types": "./dist/src/validate.d.ts",
      "import": "./dist/src/validate.js"
    }
  },
  "bin": {
    "pcp-engine": "bin/cli.js",
    "prompt-lint": "bin/lint.js",
    "pcp": "bin/pcp.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "bin",
    "benchmarks",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "node --test dist/test/*.test.js",
    "security:sast": "node scripts/security-sast.mjs",
    "security:dast": "node scripts/security-dast.mjs",
    "security:zap": "node scripts/security-zap.mjs",
    "security:html-parser": "node --test scripts/html-security.test.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:video": "npm audit --audit-level=moderate --prefix video-explainer",
    "security:all": "npm run security:audit && npm run security:audit:video && npm run security:sast && npm run security:dast && npm run security:zap && npm run security:html-parser",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "pcp-engine",
    "prompt-governance",
    "prompt-optimization",
    "prompt-engineering",
    "token-cost",
    "llm",
    "anthropic",
    "ai",
    "cost-reduction",
    "context-compression",
    "model-routing",
    "freemium",
    "prompt-scoring",
    "multi-llm",
    "prompt-linter",
    "lint",
    "pcp",
    "cli",
    "prompt-quality",
    "audit-trail",
    "policy-enforcement"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishi-banerjee1/prompt-control-plane.git"
  },
  "homepage": "https://getpcp.site/",
  "bugs": {
    "url": "https://github.com/rishi-banerjee1/prompt-control-plane/issues"
  },
  "mcpName": "io.github.rishi-banerjee1/pcp-engine",
  "author": "Rishi Banerjee",
  "license": "Elastic-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-glob": "^3.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "parse5": "8.0.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
